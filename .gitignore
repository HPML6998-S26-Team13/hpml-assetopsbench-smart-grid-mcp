# Data (large files -- track with git-lfs or download separately)
data/raw/
gcp_artifacts/
*.csv
*.parquet
*.jsonl
!data/processed/*.csv
!results/metrics/**/*.csv
# Per-scenario disposition tables for #53 are paper-facing artifacts
# (machine-readable companion to data/scenarios/generated/README.md).
!data/scenarios/generated/disposition_*.csv
results/metrics/*.preflight.csv
!results/metrics/*.jsonl
# Per-trial latency records are part of the canonical Notebook 02 input
# (run_experiment.sh writes them via the benchmark trial loop). Keep them
# tracked so reviewers can replay analysis without cluster access.
!benchmarks/**/latencies.jsonl

# Slurm logs
logs/*.out

# Locally materialized config-universe env files. Commit the generator,
# catalog, and cohort manifests; runners regenerate these per checkout/VM.
configs/config_universe/generated/

# Models (large, downloaded on cluster)
models/

# Profiling traces (large)
profiling/traces/
*.pt.trace.json
*.pt.trace.json.gz

# WandB
wandb/

# Jupyter
.ipynb_checkpoints/

# Private
private/
docs/plans/

# Secrets
.env
*.key

